<?xml version="1.0" encoding="UTF-8"?>
<!--
  tone_mini.lift: a tiny lexicon for tone-sorting tests. Documented in
  tests/tonefixture.py, which also loads it; change the two together.

  Analysis language 'xyy'. 'xyz' is the suite's usual stand-in, but langcodes
  does not register it, so LiftXML.get_langs would drop it from `analangs`.
  'xyy' is registered. The words are invented.
-->
